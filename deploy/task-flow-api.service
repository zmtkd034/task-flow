# Task Flow API(App 서버) systemd 서비스.
# 설치 위치: /etc/systemd/system/task-flow-api.service (deploy/install-app.sh가 복사한다)
[Unit]
Description=Task Flow API (FastAPI)
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=simple
User=taskflow
Group=taskflow
WorkingDirectory=/opt/task-flow/app
# DB 접속 정보(비밀번호 포함). root와 taskflow만 읽을 수 있다(권한 640).
EnvironmentFile=/etc/task-flow/task-flow.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# 외부에 직접 열지 않고 같은 컴퓨터의 Nginx(T14)만 접근한다. 개발용 8000번과 겹치지 않게 8001번을 쓴다.
ExecStart=/opt/task-flow/venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=3

# 보안: 시스템 파일 쓰기 금지, 홈 디렉터리 접근 금지, 권한 상승 금지.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
